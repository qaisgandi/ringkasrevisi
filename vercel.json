{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then php artisan migrate --force --path=database/migrations/2026_09_23_000001_create_visit_logs_table.php; fi && npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        },
        "api/blob-upload.js": {
            "maxDuration": 30
        }
    },
    "routes": [
                {
            "src": "/api/blob-upload",
            "dest": "/api/blob-upload.js"
        },
                {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
            {
        "src": "/images/(.*)",
        "dest": "/public/images/$1"
         },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://ringkasrevisi-7ywc.vercel.app",
        "DB_CONNECTION": "pgsql",
        "DB_SSLMODE": "require",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",
        "CACHE_STORE": "array",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie"
    }
}
